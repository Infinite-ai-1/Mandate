# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# Azure OpenAI (AzureOpenAI client)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Anthropic
ANTHROPIC_API_KEY=

# Model deployment names
MODEL_MELCHIOR=gpt-6.1-sol
MODEL_BALTHASAR=mai-thinking-1
MODEL_CASPER=claude-sonnet-5-5
MODEL_CHAIR=gpt-6.1-sol
MODEL_EMBED=text-embedding-3-large

# Data sources (Person 1 area: universe.py, ingest/)
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
GUARDIAN_API_KEY=
FRED_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with a real contact, or requests are
# rejected (403). Format: "<app or org name> <contact email>"
SEC_USER_AGENT="Mandate Hackathon you@example.com"

# 1 = cache only, zero network (demo / offline mode)
DEMO_MODE=0
